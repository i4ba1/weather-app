                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Blank note - 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/weather/notes",
            "description": "Rejects blank note text and must not save a row.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cityName\": \"Jakarta\",\n  \"countryCode\": \"ID\",\n  \"text\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"); });",
                  "pm.test(\"Problem Details HTTP 400\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "  const problem = pm.response.json();",
                  "  pm.expect(problem.status).to.eql(400);",
                  "  pm.expect(problem.title).to.be.a(\"string\").and.not.empty;",
